            "maxItems": 2,
            "prefixItems": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "head"
                ],
                "properties": {
                  "head": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "prefixItems": [
                      {
                        "$ref": "#/components/schemas/NeisHeadCount"
                      },
                      {
                        "$ref": "#/components/schemas/NeisHeadResult"
                      }
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "row"
