          "ATPT_OFCDC_SC_NM": {
            "type": "string"
          },
          "SD_SCHUL_CODE": {
            "type": "string"
          },
          "SCHUL_NM": {
            "type": "string"
          },
          "MMEAL_SC_CODE": {
            "type": "string"
          },
          "MMEAL_SC_NM": {
            "type": "string"
          },
          "MLSV_YMD": {
            "type": "string",
            "pattern": "^[0-9]{8}$"
