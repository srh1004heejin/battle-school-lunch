          "CAL_INFO": {
            "type": "string"
          },
          "NTR_INFO": {
            "type": "string"
          },
          "MLSV_FROM_YMD": {
            "type": "string",
            "pattern": "^[0-9]{8}$"
          },
          "MLSV_TO_YMD": {
            "type": "string",
            "pattern": "^[0-9]{8}$"
          },
          "LOAD_DTM": {
            "type": "string"
          }
        }
      },
      "SchoolInfoSuccessEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schoolInfo"
