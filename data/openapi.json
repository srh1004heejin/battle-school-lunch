{
  "openapi": "3.1.0",
  "info": {
    "title": "NEIS Open API Contract",
    "version": "1.0.0",
    "description": "학교기본정보와 급식식단정보 XLSX 명세서를 바탕으로 정리한 NEIS 외부 OpenAPI 계약입니다. JSON 호출만 문서화했습니다."
  },
  "servers": [
    {
      "url": "https://open.neis.go.kr/hub"
    }
  ],
  "paths": {
    "/schoolInfo": {
      "get": {
        "operationId": "getSchoolInfo",
        "summary": "학교 기본정보 조회",
        "parameters": [
          {
            "$ref": "#/components/parameters/Key"
          },
          {
            "$ref": "#/components/parameters/Type"
          },
          {
            "$ref": "#/components/parameters/PIndex"
          },
          {
            "$ref": "#/components/parameters/PSize"
          },
          {
            "$ref": "#/components/parameters/AtptOfcdcScCodeOptional"
          },
          {
            "$ref": "#/components/parameters/SdSchulCodeOptional"
          },
          {
            "$ref": "#/components/parameters/SchulNm"
          },
          {
            "$ref": "#/components/parameters/SchulKndScNm"
          },
          {
            "$ref": "#/components/parameters/LctnScNm"
          },
          {
            "$ref": "#/components/parameters/FondScNm"
          }
        ],
        "responses": {
          "200": {
            "description": "NEIS는 성공, 결과 없음, 오류를 모두 200 본문으로 전달합니다.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/SchoolInfoSuccessEnvelope"
                    },
                    {
                      "$ref": "#/components/schemas/SchoolInfoNoDataEnvelope"
                    },
                    {
                      "$ref": "#/components/schemas/NeisStandaloneResultEnvelope"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/mealServiceDietInfo": {
      "get": {
        "operationId": "getMealServiceDietInfo",
        "summary": "급식 식단정보 조회",
        "parameters": [
          {
            "$ref": "#/components/parameters/Key"
          },
          {
            "$ref": "#/components/parameters/Type"
          },
          {
            "$ref": "#/components/parameters/PIndex"
          },
          {
            "$ref": "#/components/parameters/PSize"
          },
          {
            "$ref": "#/components/parameters/AtptOfcdcScCodeRequired"
          },
          {
            "$ref": "#/components/parameters/SdSchulCodeRequired"
          },
          {
            "$ref": "#/components/parameters/MmealScCode"
          },
          {
            "$ref": "#/components/parameters/MlsvYmd"
          },
          {
            "$ref": "#/components/parameters/MlsvFromYmd"
          },
          {
            "$ref": "#/components/parameters/MlsvToYmd"
          }
        ],
        "responses": {
          "200": {
            "description": "NEIS는 성공, 결과 없음, 오류를 모두 200 본문으로 전달합니다.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/MealServiceDietInfoSuccessEnvelope"
                    },
                    {
                      "$ref": "#/components/schemas/MealServiceDietInfoNoDataEnvelope"
                    },
                    {
                      "$ref": "#/components/schemas/NeisStandaloneResultEnvelope"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Key": {
        "name": "Key",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "description": "인증키"
      },
      "Type": {
        "name": "Type",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "json",
            "xml"
          ],
          "default": "json"
        },
        "description": "호출 문서 형식"
      },
      "PIndex": {
        "name": "pIndex",
        "in": "query",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "description": "페이지 위치"
      },
      "PSize": {
        "name": "pSize",
        "in": "query",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        },
        "description": "페이지 당 요청 수"
      },
      "AtptOfcdcScCodeOptional": {
        "name": "ATPT_OFCDC_SC_CODE",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "시도교육청코드"
      },
      "AtptOfcdcScCodeRequired": {
        "name": "ATPT_OFCDC_SC_CODE",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "시도교육청코드"
      },
      "SdSchulCodeOptional": {
        "name": "SD_SCHUL_CODE",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "행정표준코드"
      },
      "SdSchulCodeRequired": {
        "name": "SD_SCHUL_CODE",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "행정표준코드"
      },
      "SchulNm": {
        "name": "SCHUL_NM",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "학교명"
      },
      "SchulKndScNm": {
        "name": "SCHUL_KND_SC_NM",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "학교종류명"
      },
      "LctnScNm": {
        "name": "LCTN_SC_NM",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "시도명"
      },
      "FondScNm": {
        "name": "FOND_SC_NM",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "설립명"
      },
      "MmealScCode": {
        "name": "MMEAL_SC_CODE",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "식사코드"
      },
      "MlsvYmd": {
        "name": "MLSV_YMD",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "description": "급식일자"
      },
      "MlsvFromYmd": {
        "name": "MLSV_FROM_YMD",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "description": "급식시작일자"
      },
      "MlsvToYmd": {
        "name": "MLSV_TO_YMD",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "description": "급식종료일자"
      }
    },
    "schemas": {
      "NeisResultStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "CODE",
          "MESSAGE"
        ],
        "properties": {
          "CODE": {
            "type": "string"
          },
          "MESSAGE": {
            "type": "string"
          }
        }
      },
      "NeisHeadCount": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "list_total_count"
        ],
        "properties": {
          "list_total_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "NeisHeadResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "RESULT"
        ],
        "properties": {
          "RESULT": {
            "$ref": "#/components/schemas/NeisResultStatus"
          }
        }
      },
